local function toggleLogic(btn, stateVar, textPrefix)
    stateVar = not stateVar
    btn.Text = stateVar and (textPrefix .. ": ON") or (textPrefix .. ": OFF")
    btn.BackgroundColor3 = stateVar and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(170, 0, 0)
    return stateVar
end

