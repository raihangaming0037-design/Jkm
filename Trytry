local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")

local statusText
local isTeleporting = false

-- ==========================================
-- 1. EXTREME BLACK SCREEN & FIX GUI ZINDEX
-- ==========================================
local function ultimateBlackScreen()
    pcall(function() RunService:Set3dRenderingEnabled(false) end)
    settings().Rendering.QualityLevel = 1

    local blackScreen = Instance.new("ScreenGui")
    blackScreen.Name = "hanzxs_AFK_Screen"
    blackScreen.IgnoreGuiInset = true
    blackScreen.ResetOnSpawn = false
    
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = Color3.new(0.05, 0.05, 0.05)
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.ZIndex = 999999 
    frame.Parent = blackScreen
    
    statusText = Instance.new("TextLabel")
    statusText.Size = UDim2.new(1, 0, 1, 0)
    statusText.BackgroundTransparency = 1
    statusText.TextColor3 = Color3.new(0, 1, 0)
    statusText.TextSize = 35
    statusText.Font = Enum.Font.Code
    statusText.ZIndex = 1000000 -- Memaksa teks tampil di atas frame hitam
    statusText.Text = "hanzxs AFK System Menunggu..."
    statusText.Parent = frame
    
    -- Memastikan GUI dijamin terpasang
    local success = pcall(function() 
        blackScreen.Parent = CoreGui 
    end)
    
    if not success then
        local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui", 10)
        if playerGui then
            blackScreen.Parent = playerGui
        end
    end

    Lighting.Brightness = 0
    Lighting.ClockTime = 0
    Lighting.FogEnd = 0
    Lighting.GlobalShadows = false

    local function killObject(obj)
        if obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("ShirtGraphic") or obj:IsA("Clothing") then
            pcall(function() obj:Destroy() end)
        elseif obj:IsA("BasePart") then
            obj.Transparency = 1 
            obj.Material = Enum.Material.SmoothPlastic
        end
    end

    for _, obj in pairs(Workspace:GetDescendants()) do killObject(obj) end
    Workspace.DescendantAdded:Connect(function(obj) killObject(obj) end)
    
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then terrain:Clear() end
end

ultimateBlackScreen()

-- ==========================================
-- 2. LOGIKA PLAYER COUNT & AUTO HOP hanzxs
-- ==========================================
task.wait(3)

local function teleportToPrivateServer()
    if isTeleporting then return end
    isTeleporting = true 
    
    if statusText then statusText.Text = "🚀 hanzxs System: Teleporting ke server baru..." end
    
    pcall(function()
        local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
        local afkTeleport = remotes:WaitForChild("AFKTeleport", 10)
        if afkTeleport then afkTeleport:FireServer("PrivateServer") end
    end)
    
    task.wait(10)
    isTeleporting = false
end

task.spawn(function()
    local hopTime = 2700 -- 45 Menit
    local timeRemaining = hopTime
    
    while true do
        task.wait(1)
        
        if #Players:GetPlayers() > 1 then
            if statusText then
                statusText.Text = "🚨 hanzxs System: Terdeteksi pemain lain! Auto Hop dipicu..."
            end
            teleportToPrivateServer()
            timeRemaining = hopTime 
            
        else
            timeRemaining = timeRemaining - 1
            local minutes = math.floor(timeRemaining / 60)
            local seconds = timeRemaining % 60
            
            if statusText then
                statusText.Text = string.format(
                    "hanzxs AFK System Active\nServer: Solo Player\nNext Hop dalam: %02d:%02d", 
                    minutes, 
                    seconds
                )
            end
            
            if timeRemaining <= 0 then
                teleportToPrivateServer()
                timeRemaining = hopTime 
            end
        end
    end
end)
