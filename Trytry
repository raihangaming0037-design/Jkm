local function createEsp(player)
    local Box = Instance.new("BoxHandleAdornment")
    local NameTag = Instance.new("BillboardGui")
    local NameLabel = Instance.new("TextLabel")
    local function applyEsp(char)
        local root = char:WaitForChild("HumanoidRootPart", 5)
        if not root then return end
        Box.Name = "EspBox"; Box.Parent = root; Box.Adornee = root; Box.AlwaysOnTop = true; Box.ZIndex = 10; Box.Size = Vector3.new(4, 6, 4); Box.Transparency = 0.5; Box.Color3 = Color3.fromRGB(255, 0, 0)
        NameTag.Name = "EspTag"; NameTag.Parent = root; NameTag.Adornee = root; NameTag.AlwaysOnTop = true; NameTag.Size = UDim2.new(0, 100, 0, 30); NameTag.StudsOffset = Vector3.new(0, 4, 0)
        NameLabel.Parent = NameTag; NameLabel.BackgroundTransparency = 1; NameLabel.Size = UDim2.new(1, 0, 1, 0); NameLabel.Text = player.Name; NameLabel.Font = Enum.Font.SourceSansBold; NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255); NameLabel.TextSize = 14
    end
    if player.Character then applyEsp(player.Character) end
    player.CharacterAdded:Connect(applyEsp)
    RunService.RenderStepped:Connect(function() Box.Visible = EspActive; NameTag.Enabled = EspActive end)
end
for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then createEsp(p) end end
