local function isPointSafeFromWalls(pointPart, genModel)
    if not pointPart or not pointPart:IsA("BasePart") then return false end
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignoreList = {LocalPlayer.Character, genModel}
    for _, p in ipairs(Players:GetPlayers()) do if p.Character then table.insert(ignoreList, p.Character) end end
    params.FilterDescendantsInstances = ignoreList
    local checkSize = pointPart.Size + Vector3.new(1.5, 2, 1.5)
    local overlappingParts = workspace:GetPartBoundsInBox(pointPart.CFrame, checkSize, params)
    for _, part in ipairs(overlappingParts) do
        if part.CanCollide and part.Transparency < 1 then return false end
    end
    return true
end

