local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

print("⚙️ Memulai Ultimate Black Screen & Auto Hop...")

-- ==========================================
-- 1. EXTREME BLACK SCREEN & KILL TEXTURE
-- ==========================================
local function ultimateBlackScreen()
    pcall(function() RunService:Set3dRenderingEnabled(false) end)
    settings().Rendering.QualityLevel = 1

    local blackScreen = Instance.new("ScreenGui")
    blackScreen.Name = "AFK_BlackScreen"
    blackScreen.IgnoreGuiInset = true
    blackScreen.ResetOnSpawn = false
    
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = Color3.new(0, 0, 0)
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.ZIndex = 999999999
    frame.Parent = blackScreen
    
    local success = pcall(function() blackScreen.Parent = game:GetService("CoreGui") end)
    if not success then
        blackScreen.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
    end

    Lighting.Brightness = 0
    Lighting.ClockTime = 0
    Lighting.FogEnd = 0
    Lighting.FogColor = Color3.new(0, 0, 0)
    Lighting.Ambient = Color3.new(0, 0, 0)
    Lighting.OutdoorAmbient = Color3.new(0, 0, 0)
    Lighting.GlobalShadows = false

    local function killObject(obj)
        if obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("ShirtGraphic") or obj:IsA("Clothing") then
            pcall(function() obj:Destroy() end)
        elseif obj:IsA("BasePart") then
            obj.Transparency = 1 
            obj.Material = Enum.Material.SmoothPlastic
            obj.CastShadow = false
            obj.Reflectance = 0
        end
    end

    for _, obj in pairs(Workspace:GetDescendants()) do killObject(obj) end
    Workspace.DescendantAdded:Connect(function(obj) killObject(obj) end)
    
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        terrain.WaterWaveSize = 0
        terrain.WaterWaveSpeed = 0
        terrain.WaterReflectance = 0
        terrain.WaterTransparency = 1
        terrain:Clear()
    end
end

ultimateBlackScreen()
print("✅ Black Screen & Kill Texture Selesai!")

-- ==========================================
-- 2. AUTO JOIN & LOOP HOP PRIVATE SERVER
-- ==========================================
task.wait(3)

local function teleportToPrivateServer()
    local success, err = pcall(function()
        local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
        local afkTeleport = remotes:WaitForChild("AFKTeleport", 10)
        
        if afkTeleport then
            afkTeleport:FireServer("PrivateServer")
            print("🚀 RemoteEvent AFKTeleport berhasil dikirim!")
        else
            warn("❌ RemoteEvent 'AFKTeleport' tidak ditemukan!")
        end
    end)
    
    if not success then
        warn("❌ Error saat teleport: " .. tostring(err))
    end
end

-- Pengecekan pertama saat script dijalankan
local isPrivateServer = game.PrivateServerId ~= "" and game.PrivateServerId ~= nil

if not isPrivateServer then
    print("⏳ Berada di Server Publik! Mengeksekusi teleport pertama...")
    teleportToPrivateServer()
else
    print("✅ Kamu sudah berada di Private Server.")
end

-- Thread terpisah untuk Auto Hop setiap 45 Menit
task.spawn(function()
    while true do
        -- 45 Menit = 45 * 60 = 2700 detik
        task.wait(270) 
        print("🔄 45 Menit berlalu! Melakukan Auto Hop untuk menyegarkan server...")
        teleportToPrivateServer()
    end
end)
