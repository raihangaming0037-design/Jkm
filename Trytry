-- Skenario 1: Memanipulasi RemoteEvent (Anti-Meledak)
if not getgenv().SkillCheckHooked then
    getgenv().SkillCheckHooked = true
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        -- Mencegat data yang dikirim ke server saat skill check terjadi
        if AutoSkillCheckActive and method == "FireServer" then
            local remoteName = tostring(self.Name):lower()
            if remoteName:find("skill") or remoteName:find("check") or remoteName:find("qte") or remoteName:find("repair") then
                -- Memaksa argumen pertama menjadi true (Sukses) agar server tidak meledakkan generator
                if type(args[1]) == "boolean" then
                    args[1] = true
                end
                return oldNamecall(self, unpack(args))
            end
        end
        return oldNamecall(self, ...)
    end)
end

