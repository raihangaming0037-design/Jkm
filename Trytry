-- ==========================================
-- ⚡ LOGIKA & FUNGSI UTAMA (HITBOX)
-- ==========================================

-- Fungsi merubah nilai ukuran saat kamu ketik di UI
SizeInput.FocusLost:Connect(function(enterPressed)
    local val = tonumber(SizeInput.Text)
    if val then
        HitboxSize = val
        print("[HITBOX] Ukuran diubah menjadi: " .. val)
    else
        SizeInput.Text = tostring(HitboxSize)
    end
end)

-- Fungsi tombol ON/OFF
ToggleButton.MouseButton1Click:Connect(function()
    ExpanderActive = not ExpanderActive
    if ExpanderActive then
        ToggleButton.Text = "STATUS: ACTIVE"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    else
        ToggleButton.Text = "STATUS: DISABLED"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
    end
end)

-- Fungsi tombol Ganti Transparansi
TransButton.MouseButton1Click:Connect(function()
    IsTransparent = not IsTransparent
    if IsTransparent then
        TransButton.Text = "Mode Kotak: Terlihat (0.7)"
    else
        TransButton.Text = "Mode Kotak: Bening (1.0)"
    end
end)

-- LOOP UTAMA: Otomatis memperbesar part 'HumanoidRootPart' Mob/Musuh di sekitar
RunService.RenderStepped:Connect(function()
    if not ExpanderActive then return end
    
    -- Mencari folder Workspace tempat monster/mob berada di game Evomon
    local workspaceChildren = workspace:GetChildren()
    
    for _, object in ipairs(workspaceChildren) do
        -- Validasi apakah objek tersebut adalah Mob/NPC/Player lain yang memiliki nyawa
        if object:IsA("Model") and object ~= LocalPlayer.Character and object:FindFirstChild("Humanoid") then
            local rootPart = object:FindFirstChild("HumanoidRootPart")
            
            if rootPart then
                pcall(function()
                    rootPart.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                    rootPart.CanCollide = false -- Biar karakter kamu ga mental/tabrakan saat mendekat
                    
                    if IsTransparent then
                        rootPart.Transparency = 0.7 -- Kelihatan merah/kotak samar-samar
                        rootPart.Color = Color3.fromRGB(255, 0, 0) -- Diwarnai merah biar gampang dipukul
                    else
                        rootPart.Transparency = 1.0 -- Bening total
                    end
                end)
            end
        end
    end
end)

print("[HITBOX] Script & UI Berhasil Dijalankan!")

