-- 11. STOP (dipanggil otomatis kalau script dijalankan ulang)
-- ==========================================
local function stop()
    if not alive then return end

    if state.afk then
        applyRender(false)
    end
    if state.uiHidden then
        setUiHidden(false)
    end

    alive = false
    scanId = scanId + 1

    for _, connection in ipairs(connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    for _, connection in pairs(guiWatchers) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    if mainGui then
        pcall(function()
            mainGui:Destroy()
        end)
    end

    env.HanzxsAFK = nil
end

