local function teleportToPrivateServer()
    if not CONFIG.AutoHop or state.hopping or not state.afk then return end
    state.hopping = true

    setStatus("🚀 hanzxs System: Teleporting ke server baru...")

    pcall(function()
        local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
        local afkTeleport = remotes and remotes:WaitForChild("AFKTeleport", 10)
        if afkTeleport then
            afkTeleport:FireServer("PrivateServer")
        end
    end)

    task.wait(10)
    state.hopping = false
end

task.spawn(function()
    local hopSeconds = CONFIG.HopMinutes * 60
    local remaining = hopSeconds

    task.wait(3)
    local last = os.clock()

    while alive do
        task.wait(1)

        local now = os.clock()
        local delta = now - last
        last = now

        if state.afk then
            if CONFIG.AutoHop and CONFIG.HopWhenOtherPlayers and #Players:GetPlayers() > 1 then
                setStatus("🚨 hanzxs System: Terdeteksi pemain lain! Auto Hop dipicu...")
                teleportToPrivateServer()
                remaining = hopSeconds
                last = os.clock()
            elseif CONFIG.AutoHop then
                -- timer dihitung dari waktu nyata, jadi tetap akurat walau FPS rendah
                remaining = remaining - delta

                local secondsLeft = math.max(0, math.floor(remaining))
                setStatus(string.format(
                    "hanzxs AFK System Active\nServer: Solo Player\nUI Game: %s\nNext Hop dalam: %02d:%02d",
                    state.uiHidden and "Disembunyikan" or "Tampil",
                    math.floor(secondsLeft / 60),
                    secondsLeft % 60
                ))

                if remaining <= 0 then
                    teleportToPrivateServer()
                    remaining = hopSeconds
                    last = os.clock()
                end
            else
                setStatus(string.format(
                    "hanzxs AFK System Active\nAuto Hop: OFF\nUI Game: %s",
                    state.uiHidden and "Disembunyikan" or "Tampil"
                ))
            end
        else
            -- Sistem OFF: timer dibekukan (tidak direset)
            setStatus("")
        end
    end
end)

