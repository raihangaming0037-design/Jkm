    StartAfkOn = true,          -- AFK mode langsung ON saat script dijalankan
    UiFollowsAfk = true,        -- AFK ON = UI game ikut disembunyikan, AFK OFF = UI kembali
    HideCoreGui = true,         -- ikut sembunyikan chat / playerlist / backpack / health Roblox
    KeepGuiNames = { "WindUI" },-- ScreenGui yang TIDAK boleh disembunyikan (UI script lain, mis. Silence)

    AutoHop = false,            -- false = auto hop MATI total (timer + deteksi pemain lain), true = hidup
    HopMinutes = 45,            -- jeda auto hop (menit). Jangan diisi 0, nanti hop terus-menerus
    HopWhenOtherPlayers = false, -- hop kalau ada pemain lain di server (hanya berlaku kalau AutoHop = true)
    AntiIdle = true,            -- cegah kick idle 20 menit

    FpsCap = 30,                -- batas FPS saat AFK ON (false = jangan diubah, butuh setfpscap)
    DisableEffects = true,      -- matikan particle/trail/beam/api/asap (bisa dikembalikan)
    PermanentCleanup = true,   -- true = HAPUS decal/texture/clothing + clear terrain (TIDAK bisa dikembalikan)
}

