-- ==========================================
-- 3. LOGIKA SERVER HOP (PUBLIC SERVER)
-- ==========================================
local function serverHop()
    if isTeleporting or not systemEnabled then return end
    isTeleporting = true 
    
    if statusText and systemEnabled then 
        statusText.Text = "🚀 hanzxs System: Mencari Server Publik Baru..." 
    end
    
    pcall(function()
        -- Menggunakan API Roblox untuk mencari server lain yang belum penuh
        local serversApi = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        local success, result = pcall(function()
            return game:HttpGet(serversApi)
        end)
        
        if success then
            local data = HttpService:JSONDecode(result)
            for _, server in ipairs(data.data) do
                -- Pindah ke server yang ada pemainnya, tapi belum penuh, dan bukan server yang sekarang
                if server.playing < server.maxPlayers and server.id ~= game.JobId then
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, Players.LocalPlayer)
                    break
                end
            end
        else
            -- Fallback jika HTTP Get gagal
            TeleportService:Teleport(game.PlaceId, Players.LocalPlayer)
        end
    end)
    
    task.wait(10)
    isTeleporting = false
end

-- ==========================================
-- 4. LOGIKA DETEKSI BLACKLIST & TIMER
-- ==========================================
-- Fungsi untuk mengecek apakah nama pemain masuk blacklist
local function checkBlacklist(player)
    for _, name in ipairs(blacklistedPlayers) do
        if string.lower(player.Name) == string.lower(name) or string.lower(player.DisplayName) == string.lower(name) then
            return true
        end
    end
    return false
end

-- Event: Deteksi Real-time saat ada pemain baru bergabung
Players.PlayerAdded:Connect(function(player)
    if systemEnabled and checkBlacklist(player) then
        if statusText then
            statusText.Text = "🚨 BAHAYA: [" .. player.Name .. "] Masuk Server! Auto Hop Dipicu..."
        end
        serverHop()
    end
end)

task.spawn(function()
