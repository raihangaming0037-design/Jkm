-- ==========================================
-- 4. OPTIMASI: EFFECT / CLEANUP
-- ==========================================
local EFFECT_CLASSES = { "ParticleEmitter", "Trail", "Beam", "Fire", "Smoke", "Sparkles" }

local function isEffect(obj)
    for _, className in ipairs(EFFECT_CLASSES) do
        if obj:IsA(className) then
            return true
        end
    end
    return false
end

local function optimizeObject(obj)
    if CONFIG.PermanentCleanup then
        -- Mode permanen (sama seperti versi lama): objek DIHAPUS, tidak bisa dikembalikan
        if isEffect(obj) or obj:IsA("Decal") or obj:IsA("Texture")
            or obj:IsA("Clothing") or obj:IsA("ShirtGraphic") then
            pcall(function()
                obj:Destroy()
            end)
        elseif obj:IsA("BasePart") then
            pcall(function()
                obj.Material = Enum.Material.SmoothPlastic
            end)
        end
    elseif CONFIG.DisableEffects and isEffect(obj) and obj.Enabled then
        -- Mode aman: cukup dimatikan, nanti dinyalakan lagi saat OFF
        mutedEffects[obj] = true
        pcall(function()
            obj.Enabled = false
        end)
    end
end

-- Scan Workspace per 500 objek supaya game tidak freeze
local function scanWorkspace(callback)
    scanId = scanId + 1
    local myScan = scanId
    local count = 0

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if myScan ~= scanId or not alive then return end
        callback(obj)
        count = count + 1
        if count % 500 == 0 then
            task.wait()
        end
    end
end

-- ==========================================
-- 5. AFK MODE: 3D RENDER ON / OFF
-- ==========================================
local function applyRender(on)
    state.afk = on
    blackFrame.Visible = on

    if on then
        pcall(function()
            RunService:Set3dRenderingEnabled(false)
        end)
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)

        Lighting.Brightness = 0
        Lighting.ClockTime = 0
        Lighting.FogEnd = 0
        Lighting.GlobalShadows = false

        if CONFIG.FpsCap and type(setfpscap) == "function" then
            pcall(setfpscap, CONFIG.FpsCap)
        end

        if CONFIG.DisableEffects or CONFIG.PermanentCleanup then
            task.spawn(function()
                scanWorkspace(optimizeObject)

                if CONFIG.PermanentCleanup and not permanentDone then
                    permanentDone = true
                    local terrain = Workspace:FindFirstChildOfClass("Terrain")
                    if terrain then
                        pcall(function()
                            terrain:Clear()
                        end)
                    end
                end
            end)
        end
    else
        scanId = scanId + 1 -- hentikan scan yang masih berjalan

        pcall(function()
            RunService:Set3dRenderingEnabled(true)
        end)

        if original.QualityLevel then
            pcall(function()
                settings().Rendering.QualityLevel = original.QualityLevel
            end)
        end

        Lighting.Brightness = original.Brightness
        Lighting.ClockTime = original.ClockTime
        Lighting.FogEnd = original.FogEnd
        Lighting.GlobalShadows = original.GlobalShadows

        if CONFIG.FpsCap and type(setfpscap) == "function" then
            pcall(setfpscap, original.FpsCap or 60)
        end

        for effect in pairs(mutedEffects) do
            pcall(function()
                effect.Enabled = true
            end)
            mutedEffects[effect] = nil
        end
    end
end

