-- 6. SEMBUNYIKAN UI GAME (Tap Simulator)
-- ==========================================
local function isKept(gui)
    if gui == mainGui or gui.Name == GUI_NAME then
        return true
    end

    for _, name in ipairs(CONFIG.KeepGuiNames) do
        if gui.Name == name then
            return true
        end
    end

    return false
end

local function hideGui(gui)
    if not gui:IsA("LayerCollector") or isKept(gui) then return end

    if guiState[gui] == nil then
        guiState[gui] = gui.Enabled
    end
    gui.Enabled = false

    -- Kalau game mencoba menampilkannya lagi saat mode sembunyi, tahan tetap tersembunyi
    if not guiWatchers[gui] then
        guiWatchers[gui] = gui:GetPropertyChangedSignal("Enabled"):Connect(function()
            if state.uiHidden and gui.Enabled then
                guiState[gui] = true
                gui.Enabled = false
            end
        end)
    end
end

local function hideCoreGui()
    if coreState then return end
    coreState = {}

    for _, coreType in ipairs(Enum.CoreGuiType:GetEnumItems()) do
        if coreType ~= Enum.CoreGuiType.All then
            local ok, enabled = pcall(function()
                return StarterGui:GetCoreGuiEnabled(coreType)
            end)

            if ok then
                coreState[coreType] = enabled
                if enabled then
                    pcall(function()
                        StarterGui:SetCoreGuiEnabled(coreType, false)
                    end)
                end
            end
        end
    end
end

local function restoreCoreGui()
    if not coreState then return end

    for coreType, enabled in pairs(coreState) do
        if enabled then
            pcall(function()
                StarterGui:SetCoreGuiEnabled(coreType, true)
            end)
        end
    end

    coreState = nil
end

local function setUiHidden(hidden)
    state.uiHidden = hidden -- harus diset dulu, sebelum Enabled diubah (dipantau watcher)

    if hidden then
        for _, gui in ipairs(playerGui:GetChildren()) do
            hideGui(gui)
        end

        if CONFIG.HideCoreGui then
            hideCoreGui()
        end
    else
        for gui, wasEnabled in pairs(guiState) do
            guiState[gui] = nil
            if gui.Parent then
                pcall(function()
                    gui.Enabled = wasEnabled
                end)
            end
        end

        restoreCoreGui()
    end

    refreshButtons()
end

-- UI baru yang muncul saat mode sembunyi juga langsung disembunyikan
track(playerGui.ChildAdded:Connect(function(child)
